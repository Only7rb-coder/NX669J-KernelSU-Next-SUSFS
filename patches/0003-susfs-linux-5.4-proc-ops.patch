+/* proc_ops replaced file_operations for procfs in Linux 5.6.  Keep the
+ * control nodes source-compatible with the 5.4 kernel this module targets. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 6, 0)
